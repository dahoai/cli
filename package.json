{
    "name": "@dahoai/cli",
    "version": "0.2.0",
    "description": "DadConnect command line and MCP server: use the apps you connected in DadConnect (by DAHO) with one API key.",
    "license": "MIT",
    "repository": { "type": "git", "url": "git+https://github.com/dahoai/cli.git" },
    "homepage": "https://github.com/dahoai/cli#readme",
    "bugs": { "url": "https://github.com/dahoai/cli/issues" },
    "type": "module",
    "bin": {
        "daho": "dist/bin.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && vitest run",
        "prepublishOnly": "npm run typecheck && npm test"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.31.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/node": "22.20.4",
        "typescript": "5.8.3",
        "vitest": "4.1.9"
    }
}
